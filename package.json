{
  "name": "acp-client-custom",
  "displayName": "ACP Client (Custom)",
  "description": "Agent Client Protocol client for VS Code — connect to GitHub Copilot, Claude Code, Gemini CLI, Qwen Code, Codex CLI, OpenCode, OpenClaw, Kiro CLI, Hermes Agent, and any ACP-compatible AI coding agent. Custom fork of formulahendry/vscode-acp.",
  "version": "0.2.0",
  "publisher": "zouv",
  "license": "MIT",
  "icon": "resources/icon.png",
  "bugs": {
    "url": "https://github.com/zouv/custom-vscode-acp/issues"
  },
  "homepage": "https://github.com/zouv/custom-vscode-acp/blob/custom/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/zouv/custom-vscode-acp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "acp",
    "agent",
    "ai",
    "coding agent",
    "copilot"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acp-client-custom",
          "title": "ACP Client (Custom)",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "acp-client-custom": [
        {
          "id": "acpc-sessions",
          "name": "Agents",
          "type": "tree"
        },
        {
          "id": "acpc-chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "acpc-sessions",
        "contents": "No agents configured.\n[Add Agent](command:acpc.addAgent)\nConfigure agents in settings or browse the [Agent Registry](command:acpc.browseRegistry)."
      },
      {
        "view": "acpc-chat",
        "contents": "Start chatting with an AI coding agent.\n[Connect to Agent](command:acpc.connectAgent)\nSelect an agent from the list above to begin."
      }
    ],
    "commands": [
      {
        "command": "acpc.connectAgent",
        "title": "ACP (Custom): Connect to Agent",
        "icon": "$(plug)"
      },
      {
        "command": "acpc.newConversation",
        "title": "ACP (Custom): New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "acpc.sendPrompt",
        "title": "ACP (Custom): Send Prompt"
      },
      {
        "command": "acpc.cancelTurn",
        "title": "ACP (Custom): Cancel Current Turn",
        "icon": "$(debug-stop)"
      },
      {
        "command": "acpc.disconnectAgent",
        "title": "ACP (Custom): Disconnect Agent",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "acpc.openChat",
        "title": "ACP (Custom): Open Chat Panel"
      },
      {
        "command": "acpc.addAgent",
        "title": "ACP (Custom): Add Agent Configuration",
        "icon": "$(add)"
      },
      {
        "command": "acpc.removeAgent",
        "title": "ACP (Custom): Remove Agent"
      },
      {
        "command": "acpc.showLog",
        "title": "ACP (Custom): Show Log"
      },
      {
        "command": "acpc.showTraffic",
        "title": "ACP (Custom): Show Protocol Traffic"
      },
      {
        "command": "acpc.browseRegistry",
        "title": "ACP (Custom): Browse Agent Registry"
      },
      {
        "command": "acpc.setMode",
        "title": "ACP (Custom): Set Agent Mode"
      },
      {
        "command": "acpc.setModel",
        "title": "ACP (Custom): Set Agent Model"
      },
      {
        "command": "acpc.attachFile",
        "title": "ACP (Custom): Attach File to Prompt",
        "icon": "$(attach)"
      },
      {
        "command": "acpc.refreshAgents",
        "title": "ACP (Custom): Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "acpc.refreshSessions",
        "title": "ACP (Custom): Refresh Sessions"
      },
      {
        "command": "acpc.openSession",
        "title": "ACP (Custom): Open Session"
      },
      {
        "command": "acpc.loadMoreSessions",
        "title": "ACP (Custom): Load More Sessions"
      },
      {
        "command": "acpc.copySessionId",
        "title": "ACP (Custom): Copy Session ID"
      },
      {
        "command": "acpc.forgetSession",
        "title": "ACP (Custom): Forget Session"
      },
      {
        "command": "acpc.restartAgent",
        "title": "ACP (Custom): Restart Agent",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "acpc.openSession",
          "when": "false"
        },
        {
          "command": "acpc.loadMoreSessions",
          "when": "false"
        },
        {
          "command": "acpc.copySessionId",
          "when": "false"
        },
        {
          "command": "acpc.forgetSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "acpc.addAgent",
          "when": "view == acpc-sessions",
          "group": "navigation@1"
        },
        {
          "command": "acpc.refreshAgents",
          "when": "view == acpc-sessions",
          "group": "navigation@2"
        },
        {
          "command": "acpc.browseRegistry",
          "when": "view == acpc-sessions"
        },
        {
          "command": "acpc.newConversation",
          "when": "view == acpc-chat",
          "group": "navigation@1"
        },
        {
          "command": "acpc.attachFile",
          "when": "view == acpc-chat",
          "group": "navigation@2"
        },
        {
          "command": "acpc.cancelTurn",
          "when": "view == acpc-chat && acpc.turnInProgress",
          "group": "navigation@3"
        },
        {
          "command": "acpc.disconnectAgent",
          "when": "view == acpc-chat",
          "group": "navigation@4"
        },
        {
          "command": "acpc.showLog",
          "when": "view == acpc-chat"
        },
        {
          "command": "acpc.showTraffic",
          "when": "view == acpc-chat"
        },
        {
          "command": "acpc.restartAgent",
          "when": "view == acpc-chat"
        }
      ],
      "view/item/context": [
        {
          "command": "acpc.connectAgent",
          "when": "view == acpc-sessions && viewItem == agent-disconnected",
          "group": "inline"
        },
        {
          "command": "acpc.disconnectAgent",
          "when": "view == acpc-sessions && viewItem == agent-connected",
          "group": "inline"
        },
        {
          "command": "acpc.removeAgent",
          "when": "view == acpc-sessions && viewItem =~ /^agent/"
        },
        {
          "command": "acpc.restartAgent",
          "when": "view == acpc-sessions && viewItem == agent-connected"
        },
        {
          "command": "acpc.refreshSessions",
          "when": "view == acpc-sessions && viewItem =~ /^agent/",
          "group": "session@1"
        },
        {
          "command": "acpc.copySessionId",
          "when": "view == acpc-sessions && viewItem =~ /^session/",
          "group": "session@1"
        },
        {
          "command": "acpc.forgetSession",
          "when": "view == acpc-sessions && viewItem == session-local",
          "group": "session@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "acpc.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "acpc.cancelTurn",
        "key": "escape",
        "when": "acpc.turnInProgress"
      }
    ],
    "configuration": {
      "title": "ACP Client (Custom)",
      "properties": {
        "acpc.agents": {
          "type": "object",
          "description": "Agent configurations. Each key is the agent name, value has command, args, and env.",
          "default": {
            "GitHub Copilot": {
              "command": "npx",
              "args": [
                "@github/copilot-language-server@latest",
                "--acp"
              ],
              "env": {}
            },
            "Claude Code": {
              "command": "npx",
              "args": [
                "@agentclientprotocol/claude-agent-acp@latest"
              ],
              "env": {}
            },
            "Gemini CLI": {
              "command": "npx",
              "args": [
                "@google/gemini-cli@latest",
                "--experimental-acp"
              ],
              "env": {}
            },
            "Qwen Code": {
              "command": "npx",
              "args": [
                "@qwen-code/qwen-code@latest",
                "--acp",
                "--experimental-skills"
              ],
              "env": {}
            },
            "Auggie CLI": {
              "command": "npx",
              "args": [
                "@augmentcode/auggie@latest",
                "--acp"
              ],
              "env": {
                "AUGMENT_DISABLE_AUTO_UPDATE": "1"
              }
            },
            "Qoder CLI": {
              "command": "npx",
              "args": [
                "@qoder-ai/qodercli@latest",
                "--acp"
              ],
              "env": {}
            },
            "Codex CLI": {
              "command": "npx",
              "args": [
                "@zed-industries/codex-acp@latest"
              ],
              "env": {}
            },
            "OpenCode": {
              "command": "npx",
              "args": [
                "opencode-ai@latest",
                "acp"
              ],
              "env": {}
            },
            "OpenClaw": {
              "command": "npx",
              "args": [
                "openclaw",
                "acp"
              ],
              "env": {}
            },
            "Kiro CLI": {
              "command": "kiro-cli",
              "args": [
                "acp"
              ],
              "env": {}
            },
            "Hermes Agent": {
              "command": "hermes",
              "args": [
                "acp"
              ],
              "env": {}
            }
          }
        },
        "acpc.autoApprovePermissions": {
          "type": "string",
          "enum": [
            "ask",
            "allowAll"
          ],
          "default": "ask",
          "description": "Automatically approve agent permission requests. 'ask' always prompts, 'allowAll' approves everything."
        },
        "acpc.defaultWorkingDirectory": {
          "type": "string",
          "default": "",
          "description": "Default working directory for agent sessions. Leave empty to use the current workspace folder."
        },
        "acpc.logTraffic": {
          "type": "boolean",
          "default": true,
          "description": "Log all ACP protocol traffic to the output channel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --max-warnings 0",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.1",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.0"
  }
}
